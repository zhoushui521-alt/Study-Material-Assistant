# 本地默认只监听回环地址；Docker Compose 会在容器内覆盖为 0.0.0.0。
APP_HOST=127.0.0.1
APP_PORT=8000

# SQLite、用户文件、Chroma、任务状态和安全请求日志的统一持久化根目录。
APP_DATA_DIR=data

# Docker Compose 暴露到宿主机的端口，不传入应用进程。
ZHIXING_PORT=8000

# 从百炼控制台创建的 API Key。不要提交真实 .env 文件，也不要把 Key 发到聊天中。
BAILIAN_API_KEY=

# 从百炼控制台“API 文档”复制 OpenAI 兼容模式的 Base URL。
# 示例：https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_BASE_URL=

BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_EMBEDDING_DIMENSIONS=1024

# 用于根据检索到的资料生成最终答案的对话模型。
BAILIAN_CHAT_MODEL=qwen-plus

# Stage 5.5 Model Gateway。仅 DEFAULT_PROVIDER=qwen 时回退现有百炼配置；MODEL_* 可独立覆盖 ChatModel，
# 不会改变 Embedding 与现有 Chroma Index Manifest。
DEFAULT_PROVIDER=qwen
DEFAULT_MODEL=qwen-plus
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_TIMEOUT=60
MODEL_MAX_TOKENS=
MODEL_TEMPERATURE=0.2

# 仅用于加密用户 BYOK 凭证。必须跨重启保持稳定，不要提交真实值。
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MODEL_CREDENTIAL_ENCRYPTION_KEY=
